# Application Environment Settings
APP_NAME=dogfood-2026
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_secure_secret_key_in_production

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_example
POSTGRES_DB=dogfood_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_example@db:5432/dogfood_db

# Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=DOGFOOD 2026
